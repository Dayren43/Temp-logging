# Default location used on first load (before the user customizes via the
# Tweaks panel). Vite bakes these into the built JS bundle, so they're visible
# in the served app — fine for a personal homelab dashboard, not for secrets.
# Copy this file to `.env` and edit. `.env` is gitignored.
VITE_LOCATION_NAME=Stockholm
VITE_LOCATION_LAT=59.3293
VITE_LOCATION_LON=18.0686
